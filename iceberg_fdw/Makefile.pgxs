#-------------------------------------------------------------------------
#
# Makefile.pgxs —— out-of-tree PGXS 构建（本机 docker 验证用）
#
# 设计 canonical 构建是源码树内（见 Makefile）。本文件仅用于在已安装的
# openGauss（含 pgxs + server 头）上做快速编译/验收，借用 openGauss 自身
# 保存的编译/ABI 标志，降低 C++ 扩展加载的 ABI 不匹配风险。
#
#   make -f Makefile.pgxs USE_PGXS=1 PG_CONFIG=/usr/local/opengauss/bin/pg_config install
#
#-------------------------------------------------------------------------

MODULE_big = iceberg_fdw
EXTENSION = iceberg_fdw
DATA = iceberg_fdw.control iceberg_fdw--1.0.sql

OBJS = src/iceberg_fdw.o \
       src/plan/plan_callbacks.o \
       src/plan/fdw_private.o \
       src/exec/scan_callbacks.o \
       src/exec/vec_scan_callbacks.o \
       src/catalog/catalog_resolve.o \
       src/ddl/validate_table_def.o

# 内部头文件查找路径（src/iceberg_fdw.h、src/exec/scan_state.h）
PG_CPPFLAGS = -I$(srcdir)/src

PG_CONFIG ?= pg_config
PGXS := $(shell $(PG_CONFIG) --pgxs)
include $(PGXS)

# openGauss 的 PGXS 把 -fPIE 放进 CPPFLAGS（内核以 PIE 构建），而编译命令里
# CPPFLAGS 在最后，会盖掉前面的 -fPIC，与 -shared 冲突。把 -fPIC 追加到
# CPPFLAGS 末尾，确保它是最后一个生效的代码生成标志。
override CPPFLAGS += -fPIC
